# Copy to backend/.env
DATABASE_URL=postgresql+psycopg2://fraud_user:fraud_pass@localhost:5432/fraud_detection_db
JWT_SECRET_KEY=change-this-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATASET_PATH=../data/creditcard.csv
MODEL_DIR=../ml_models
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70
APP_NAME=Intelligent Credit Card Fraud Detection System
ENV=development
